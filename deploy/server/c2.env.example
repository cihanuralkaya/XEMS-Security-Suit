# XEMS C2 (Command & Control) sunucu yapılandırması — ÖRNEK.
# Kurulum betiği bu değerleri üretir; elle düzenlerken buradan yararlanın.

# --- Kalıcılık ---
# PostgreSQL bağlantısı. BOŞ bırakılırsa BELLEK-İÇİ DEMO modu çalışır (kalıcılık
# yok — yalnız değerlendirme/test için).
XEMS_DATABASE_URL=

# Bellek-içi DEMO modu (kalıcılık YOK) yalnız bununla açılır — üretimde
# XEMS_DATABASE_URL doldurun ve bunu ayarlamayın.
XEMS_DEMO=1

# --- Ana anahtar (ZORUNLU) ---
# 32 bayt, base64. Alan şifreleme + HMAC blind index alt anahtarları bundan
# türetilir. GÜVENLE saklayın; kaybı verinin okunamaması demektir.
#
# DOSYA-TABANLI SIR (önerilen, üretim): düz-metin env yerine değeri bir dosyadan
# okutmak için XEMS_MASTER_KEY yerine XEMS_MASTER_KEY_FILE=/path kullanın. Aynı
# kalıp XEMS_DATABASE_URL_FILE ve XEMS_MASTER_KEY_OLD_FILE için de geçerli. Böylece
# sır /proc/<pid>/environ veya `ps` üzerinden sızmaz. systemd LoadCredential,
# Docker/K8s secrets ve Vault agent dosya-tabanlı sır sağlar. Env öncelikli;
# yoksa _FILE okunur (içerik kırpılır).
XEMS_MASTER_KEY=
XEMS_MASTER_KEY_FILE=
# Anahtar ROTASYONU (opsiyonel): virgülle ayrılmış ESKİ base64 ana anahtarlar. Yeni
# veri XEMS_MASTER_KEY ile şifrelenir; eski at-rest veri bu anahtarlarla ÇÖZÜLMEYE
# devam eder (veri kaybı YOK). Rotasyon: yeni anahtarı XEMS_MASTER_KEY yap, eskisini
# buraya taşı; tüm eski veri yeniden yazıldıktan sonra buradan kaldır.
XEMS_MASTER_KEY_OLD=

# --- TLS materyali (ZORUNLU) ---
XEMS_CA_CERT=/etc/xems/pki/ca.crt
XEMS_CA_KEY=/etc/xems/pki/ca.key
XEMS_SERVER_CERT=/etc/xems/pki/server.crt
XEMS_SERVER_KEY=/etc/xems/pki/server.key

# --- Dinleme adresleri ---
XEMS_LISTEN_AGENT=:8443
XEMS_LISTEN_ENROLL=:8444
XEMS_LISTEN_ADMIN=:8445

# --- Demo modu yönetici tohumu (yalnız XEMS_DATABASE_URL boşken geçerli) ---
# Üretimde (DB modu) yönetici için: tools/adminseed ile INSERT SQL üretin.
XEMS_DEMO_ADMIN_EMAIL=admin@local
XEMS_DEMO_ADMIN_PASSWORD=

# --- Saklama (KVKK) ---
XEMS_RETENTION_DAYS=90

# --- Giriş kaba-kuvvet koruması ---
# İstemci başına bu kadar başarısız denemeden sonra XEMS_LOGIN_LOCKOUT süresi kilit.
XEMS_LOGIN_MAX_ATTEMPTS=5
XEMS_LOGIN_LOCKOUT=15m

# --- Gözlemlenebilirlik (Prometheus /metrics) ---
# Ayarlanırsa GET /metrics bu statik Bearer token ile açılır (scraper: Authorization:
# Bearer <token>). BOŞ bırakılırsa uç tamamen KAPALIDIR (toplu veriyi kimliksiz
# sızdırmama — güvenli varsayılan). Rastgele üretin: openssl rand -hex 24
XEMS_METRICS_TOKEN=
# İkiliye gömülü sürüm etiketi (xems_build_info metriği için); boşsa "dev".
XEMS_BUILD_VERSION=

# --- Dış uyarı (SOC webhook) ---
# Ayarlanırsa yüksek önem düzeyli güvenlik olayları bir HTTPS webhook'una POST
# edilir (Slack/Teams/genel). URL https OLMALI. Boşsa uyarı gönderilmez.
XEMS_ALERT_WEBHOOK_URL=
# Uyarı eşiği: bu ve üstü önem düzeyleri gönderilir (INFO/LOW/MEDIUM/HIGH/CRITICAL).
XEMS_ALERT_MIN_SEVERITY=HIGH
# Uyarı gövde biçimi: "json" (varsayılan, ham Alert) veya "slack" (Slack/Teams
# incoming webhook — {"text":...} okunabilir mesaj).
XEMS_ALERT_FORMAT=
# Yönlendirme (routing): ayarlanırsa webhook'a YALNIZ eşleşen uyarılar gider.
# Virgülle ayrılmış kategori allowlist'i (ör. SECURITY,POLICY_VIOLATION). Boş → hepsi.
XEMS_ALERT_CATEGORIES=
# Virgülle ayrılmış ATT&CK tekniği allowlist'i (ör. T1055,T1003). Boş → hepsi.
XEMS_ALERT_TECHNIQUES=
# Yükseltme (escalation): aynı cihaz|kategori için ESCALATE_WINDOW içinde bu kadar
# yüksek-önem uyarı birikince BİR kez CRITICAL "ESCALATED" uyarısı üretilir (on-call
# sayfası). 0/boş = kapalı.
XEMS_ALERT_ESCALATE_COUNT=
# Yükseltme penceresi (varsayılan 10m). Ör: 5m, 1h.
XEMS_ALERT_ESCALATE_WINDOW=
# Yükseltmeye sayılan asgari önem (varsayılan HIGH).
XEMS_ALERT_ESCALATE_MIN_SEVERITY=HIGH

# --- Çok-sinyal korelasyon (gelişmiş korelasyon) ---
# Aynı cihazda XEMS_CHAIN_WINDOW (varsayılan 15m) içinde XEMS_CHAIN_THRESHOLD
# (varsayılan 3) FARKLI kill-chain sinyali (teknik/taktik) birikirse, tek tespitten
# daha güçlü kanıt olan YÜKSEK-GÜVENLİ bir saldırı-zinciri uyarısı üretilir.
# Eşik 0 → kapalı.
XEMS_CHAIN_WINDOW=
XEMS_CHAIN_THRESHOLD=

# --- Harici log alımı (SIEM ingest, #21) ---
# Ayarlanırsa POST /api/ingest açılır: harici kaynaklar (güvenlik duvarı, bulut,
# kimlik sağlayıcı, başka SIEM) JSON veya CEF loglarını bu statik Bearer token ile
# gönderir; loglar XEMS olay modeline normalize edilip korelasyon/tespit/hunt
# yüzeyine yazılır. Her kaynak adından türetilen kararlı bir cihaz kimliğine eşlenir.
# Boşsa uç KAPALIDIR. Güçlü, rastgele bir token kullanın.
#   JSON: Content-Type: application/json, gövde [{"source","category","severity","message",...}]
#   CEF : satır başına "CEF:0|Vendor|Product|...".
XEMS_INGEST_TOKEN=

# --- Bakım / bastırma pencereleri (#18) ---
# Ayarlanırsa planlı bakım aralıklarında (opsiyonel cihaz/kategori kapsamı) uyarılar
# bastırılır — beklenen etkinlik SOC'u gereksiz uyandırmaz. JSON dizisi; biçim için
# deploy/server/suppress.example.json. allow_above ile kritikler yine geçebilir.
# Konsol görünürlüğü: GET /api/maintenance. Boşsa bastırma kapalı.
XEMS_SUPPRESS_FILE=
# Canlı hot-reload: ayarlanırsa (ör. 5m) pencere dosyası periyodik yeniden okunur ve
# SUNUCU YENİDEN BAŞLATILMADAN güncellenir. Okuma hatasında eski küme korunur. Boş/0 = kapalı.
XEMS_SUPPRESS_RELOAD_INTERVAL=

# --- İmzalı denetim dışa aktarımı (harici değişmez arşiv, #16) ---
# GET /api/audit/export, denetim izini kurcalama-kanıtlı hash-zincirli JSONL olarak
# verir (denetçi/WORM arşiv C2'DEN BAĞIMSIZ doğrular: server/cmd/auditverify).
# Bu Ed25519 özel anahtar (base64) ayarlıysa dışa aktarıma imzalı manifest eklenir
# (köken kanıtı). Boşsa dışa aktarım imzasızdır (yalnız hash zinciri bütünlüğü).
# Üretme: go run ./tools/otasign -genkey -out ./audit-keys (özel anahtarı base64'le).
XEMS_AUDIT_EXPORT_KEY=

# --- Otomatik müdahale (SOAR) ---
# =1 ise KRİTİK güvenlik olayında (kurcalama, sahte güncelleme/script reddi) cihaz
# otomatik KARANTİNAYA alınır (insan beklemeden). Varsayılan KAPALI — karantina
# bozucu bir eylemdir; bilinçli açın.
XEMS_AUTO_RESPONSE=

# --- Tehdit istihbaratı (IoC) ---
# Ayarlanırsa bilinen-kötü göstergeler (IP/MAC/alan adı/hash/süreç) yüklenir ve
# eşleşen olaylar KRİTİK uyarı üretir. Biçim için deploy/server/ioc.example.txt.
XEMS_IOC_FILE=
# Canlı hot-reload: ayarlanırsa (ör. 5m) IoC dosyası periyodik yeniden okunur ve
# göstergeler SUNUCU YENİDEN BAŞLATILMADAN güncellenir (yeni tehdit istihbaratı
# anında yürürlüğe girer). Okuma hatasında eski küme korunur. Boş/0 = kapalı.
XEMS_IOC_RELOAD_INTERVAL=

# --- Özel tespit kuralları (operatör-tanımlı) ---
# Ayarlanırsa yerleşik tespit kurallarına EKLENİR (koda dokunmadan kuruma özgü
# tespit içeriği). JSON dizisi; biçim için deploy/server/detect-rules.example.json.
XEMS_DETECT_RULES_FILE=
# Canlı hot-reload: ayarlanırsa (ör. 5m) ve XEMS_DETECT_RULES_FILE varsa, kural
# dosyası periyodik yeniden okunur ve motor SUNUCU YENİDEN BAŞLATILMADAN güncellenir
# (hem ingest değerlendirmesi hem konsol kataloğu). Okuma hatasında eski korunur.
# Boş/0 = kapalı.
XEMS_DETECT_RELOAD_INTERVAL=

# --- SIEM iletici (syslog + CEF/LEEF) ---
# Ayarlanırsa olaylar bir SIEM'e (ArcSight/QRadar/Splunk) syslog üzerinden iletilir.
# Adres host:port. Boşsa iletilmez.
XEMS_SIEM_ADDR=
# Taşıma: "udp" (varsayılan) veya "tcp".
XEMS_SIEM_PROTO=udp
# Biçim: "cef" (varsayılan, ArcSight) veya "leef" (QRadar).
XEMS_SIEM_FORMAT=cef
# İletim eşiği: bu ve üstü önem düzeyleri (INFO/LOW/MEDIUM/HIGH/CRITICAL).
XEMS_SIEM_MIN_SEVERITY=HIGH

# --- Zafiyet eşleştirme (envanterden) ---
# Ayarlanırsa yazılım envanteri bilinen zafiyet veri kümesiyle eşleştirilir ve
# zafiyetli cihazlar konsolda işaretlenir. Biçim için deploy/vuln-sample.json.
XEMS_VULN_FILE=

# --- Çift-kontrol (dört-göz) WIPE ---
# =1 ise uzaktan WIPE bir ADMIN'in TALEBİ + FARKLI bir ADMIN'in ONAYINI gerektirir;
# onaya kadar komut kuyruğa GİRMEZ (tek ele geçirilmiş/kötü-niyetli ADMIN filoyu
# silemez). Boş/0 = tek-ADMIN doğrudan WIPE (eski davranış). Yıkıcı eylemler için
# önerilir.
XEMS_WIPE_DUAL_CONTROL=

# --- Yatay ölçekleme (çok-düğüm HA) ---
# =1 ise canlı konsol akışı (SSE) düğümler arası Postgres LISTEN/NOTIFY ile
# fan-out edilir; yük dengeleyici arkasındaki TÜM C2 düğümleri aynı PostgreSQL'i
# paylaşmalı (XEMS_DATABASE_URL zorunlu). Boş/0 → tek düğüm (bellek-içi bus).
# Bildirim kanalını değiştirmek için XEMS_CLUSTER_CHANNEL (varsayılan xems_notice).
XEMS_CLUSTER=
XEMS_CLUSTER_CHANNEL=

# --- Loglama biçimi ---
# "json" → tüm sunucu logları yapısal JSON satırları (SIEM/log toplama, ör. Loki/ELK).
# Boş/diğer → "[c2] " prefix'li standart metin (varsayılan).
XEMS_LOG_FORMAT=

# --- C2 beacon tespiti (ağ periyodikliği) ---
# Varsayılan AÇIK. netconn geçmişini periyodik analiz eder; düzenli-aralıklı
# (düşük-jitter) uzak IP'leri olası C2 beacon (SECURITY olayı) olarak işaretler —
# bilinen IoC olmadan bilinmeyen C2'yi yakalar. Kapatmak için değere ayarlayın.
XEMS_BEACON_DISABLE=
# Analiz sıklığı (vars. 10m) ve geriye-bakış penceresi (vars. 2h).
XEMS_BEACON_INTERVAL=
XEMS_BEACON_WINDOW=
